{
  "name": "aacl-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "aacl": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/web",
    "web",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts",
    "check": "npm run build && npm test && npm run test:ui",
    "start": "node dist/src/cli.js serve --port 4319",
    "dev": "npm run build && node dist/src/cli.js serve --dir .local --port 4318",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
